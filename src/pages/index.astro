---
// Landing page, styled to the tailFeathers design specification v1.0 (pastel):
// sky field + glass surfaces on the inspirational hero, flat paper below,
// butter as the single signal colour, ink carrying all typography.
//
// One deliberate deviation, documented: the spec's type scale tops out at
// Display 34 (it is written for app screens); a marketing hero needs more, so
// the hero headline scales up to 64px while keeping Display's weight (500)
// and tracking (-0.02em). Everything else uses the scale as written.
const title = 'tailFeathers — Spin the globe. Plan the trip.';
const description =
  'tailFeathers turns trip planning into play: a living 3D globe with curated ' +
  'destinations, real flights and roads, and a trip timeline you build by touch.';
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" href="/mark.svg" type="image/svg+xml" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content="/og-cover.png" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400&display=swap"
  rel="stylesheet"
/>
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "tailFeathers",
  "applicationCategory": "TravelApplication",
  "operatingSystem": "Web",
  "description": "A game-like 3D travel planner: spin a living globe, browse curated destinations, and build your trip on a timeline with real flights and roads.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}
</script>
<style is:global>
  /* ---------- tokens (design spec §2, §3, §8) ---------- */
  :root {
    --tf-ink: #33406B;
    --tf-sky: #B9CDF5;
    --tf-butter: #FFE08A;
    --tf-blush: #FFD0C2;
    --tf-mint: #C9E6D8;
    --tf-mist: #EEF2FB;
    --tf-white: #FFFFFF;
    --tf-border: #E3E9F6;
    --sans: 'Outfit', 'Segoe UI', sans-serif;
    --mono: 'IBM Plex Mono', Consolas, monospace;
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --enter: 160ms;
    --panel: 240ms;
    /* Glass recipe (§4) */
    --glass-fill: linear-gradient(160deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0.32));
    --glass-border: 1px solid rgba(255, 255, 255, 0.75);
    --glass-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 8px 22px rgba(51, 64, 107, 0.10);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--tf-mist);
    color: var(--tf-ink);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
  }
  a { color: inherit; text-decoration: none; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  a:focus-visible, button:focus-visible {
    outline: 2px solid var(--tf-ink); outline-offset: 2px; border-radius: 4px;
  }

  /* ---------- type roles (§3) ---------- */
  .eyebrow {
    font-family: var(--mono); font-size: 11px; line-height: 1.4; font-weight: 400;
    letter-spacing: 0.14em; text-transform: uppercase;
  }
  .small { font-size: 13px; line-height: 1.5; }

  /* ---------- nav: logo only, frosts to glass on scroll ---------- */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 10;
    background: transparent; border-bottom: 1px solid transparent;
    transition: background var(--panel) var(--ease), border-color var(--panel) var(--ease), box-shadow var(--panel) var(--ease);
  }
  nav.scrolled {
    background: var(--glass-fill);
    backdrop-filter: blur(20px) saturate(150%);
    border-bottom: var(--glass-border);
    box-shadow: 0 8px 22px rgba(51, 64, 107, 0.10);
  }
  .nav-inner {
    display: flex; align-items: center; height: 68px;
    padding: 0 clamp(20px, 3vw, 44px);
  }
  /* Wordmark: always "tailFeathers" — tail at 300, Feathers at 600 (§1, §3).
     Gap ≈ 33% of the mark's diameter. */
  .logo { display: flex; align-items: center; gap: 10px; font-size: 21px; line-height: 1; }
  .logo img { width: 30px; height: 30px; display: block; }
  .wm-tail { font-weight: 300; }
  .wm-feathers { font-weight: 600; }

  /* ---------- buttons (§5) ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--sans); font-size: 15px; line-height: 1; font-weight: 500;
    border: none; cursor: pointer; white-space: nowrap;
    transition: transform var(--enter) var(--ease), box-shadow var(--enter) var(--ease), background var(--enter) var(--ease);
  }
  /* Primary on a glass screen: butter fill, ink label, radius 12, height 46.
     The one signal on the screen. */
  .btn-signal {
    background: var(--tf-butter); color: var(--tf-ink);
    height: 46px; padding: 0 22px; border-radius: 12px;
  }
  .btn-signal:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(51, 64, 107, 0.14); }
  /* Primary on paper: ink fill, white label, radius 14, height 48. */
  .btn-paper {
    background: var(--tf-ink); color: var(--tf-white);
    height: 48px; padding: 0 24px; border-radius: 14px;
  }
  .btn-paper:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(51, 64, 107, 0.18); }
  /* Secondary: 1px ink border, transparent fill. */
  .btn-secondary {
    background: transparent; color: var(--tf-ink);
    border: 1px solid var(--tf-ink);
    height: 46px; padding: 0 22px; border-radius: 12px;
  }
  .btn-secondary:hover { transform: translateY(-1px); }
  /* Tertiary: underlined ink label, no fill. */
  .btn-tertiary {
    background: none; color: var(--tf-ink);
    text-decoration: underline; text-underline-offset: 3px;
    padding: 12px 10px; font-weight: 500;
  }

  /* ---------- hero: sky field, glass card over the live globe ---------- */
  .hero {
    position: relative; overflow: hidden;
    height: 94vh; min-height: 640px;
    background: var(--tf-sky);
  }
  #globeEmbed {
    position: absolute; top: -32%; height: 164%;
    left: 4%; width: 140%;
  }
  /* Managed scrim so ink and glass stay legible over the imagery we control
     (§4, §6) — sky-tinted, fading into the planet. */
  .hero-wash {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: linear-gradient(90deg,
      rgba(185, 205, 245, 0.85) 0%,
      rgba(185, 205, 245, 0.45) 40%,
      rgba(185, 205, 245, 0.0) 68%);
  }
  .hero-card {
    position: absolute; z-index: 3; top: 50%; transform: translateY(-52%);
    left: clamp(24px, 6vw, 110px);
    max-width: 620px;
    background: var(--glass-fill);
    backdrop-filter: blur(20px) saturate(150%);
    border: var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: 24px;
    padding: 36px 38px;
  }
  .hero-card .eyebrow { color: var(--tf-ink); opacity: 0.75; }
  h1 {
    font-size: clamp(40px, 5vw, 64px); line-height: 1.08;
    font-weight: 500; letter-spacing: -0.02em; text-wrap: balance;
    margin: 14px 0 16px;
  }
  h1 .light { font-weight: 300; }
  .lede { font-size: 16px; max-width: 30em; }
  .hero-cta { display: flex; gap: 12px; margin-top: 26px; align-items: center; flex-wrap: wrap; }
  .hero-note { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.65; margin-top: 18px; }
  .globe-boot {
    position: absolute; inset: 0; z-index: 1;
    display: flex; align-items: center; justify-content: center;
    color: var(--tf-ink); opacity: 0.6;
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em;
    pointer-events: none; transition: opacity var(--panel) var(--ease);
  }

  /* ---------- the dock: glass pill (tab bar recipe, §5) ---------- */
  .globe-caption {
    position: absolute; z-index: 3; bottom: 96px; left: 50%; transform: translateX(-50%);
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--tf-ink); opacity: 0.7; white-space: nowrap;
  }
  .hero-dock {
    position: absolute; z-index: 3; bottom: 24px; left: 50%; transform: translateX(-50%);
    display: flex; align-items: center; gap: 4px;
    padding: 6px 8px; border-radius: 20px;
    background: var(--glass-fill);
    backdrop-filter: blur(20px) saturate(150%);
    border: var(--glass-border);
    box-shadow: var(--glass-shadow);
    max-width: calc(100vw - 32px);
  }
  .dock-toggle { display: flex; }
  .mode-chip {
    font-family: var(--sans); font-size: 14px; font-weight: 400;
    min-height: 44px; padding: 0 14px; border-radius: 16px; cursor: pointer;
    border: none; background: transparent; color: var(--tf-ink); opacity: 0.7;
    transition: opacity var(--enter) var(--ease), font-weight var(--enter) var(--ease);
  }
  .mode-chip.on { font-weight: 600; opacity: 1; }
  .dock-divider { width: 1px; height: 24px; background: rgba(51, 64, 107, 0.18); margin: 0 6px; }
  .dock-links { display: flex; align-items: center; }
  .dock-links a {
    font-size: 14px; font-weight: 500; color: var(--tf-ink);
    min-height: 44px; display: inline-flex; align-items: center;
    padding: 0 14px; border-radius: 16px; white-space: nowrap;
    transition: background var(--enter) var(--ease);
  }
  .dock-links a:hover { background: rgba(255, 255, 255, 0.55); }
  .dock-login { text-decoration: underline; text-underline-offset: 3px; }
  .dock-cta {
    font-size: 14px; font-weight: 500; color: var(--tf-ink);
    border: 1px solid var(--tf-ink); background: transparent;
    min-height: 44px; display: inline-flex; align-items: center;
    padding: 0 18px; border-radius: 16px; white-space: nowrap; margin-left: 4px;
  }
  .dock-cta:hover { background: rgba(255, 255, 255, 0.55); }

  /* ---------- paper sections (§4: elevation = border, no shadow) ---------- */
  section { padding: 88px 0; }
  section + section { border-top: 1px solid var(--tf-border); }
  section .eyebrow { opacity: 0.75; margin-bottom: 12px; }
  h2 {
    font-size: clamp(26px, 3vw, 34px); line-height: 1.15;
    font-weight: 500; letter-spacing: -0.02em; text-wrap: balance;
    margin-bottom: 12px;
  }
  .section-lede { max-width: 40em; margin-bottom: 44px; opacity: 0.85; }

  .mode-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .mode-card {
    background: var(--tf-white); border: 1px solid var(--tf-border);
    border-radius: 16px; padding: 14px 16px 18px; min-height: 180px;
    display: flex; flex-direction: column; gap: 10px;
    transition: transform var(--enter) var(--ease), border-color var(--enter) var(--ease);
  }
  .mode-card:hover { transform: translateY(-2px); border-color: var(--tf-ink); }
  .mode-swatch { width: 100%; height: 64px; border-radius: 10px; }
  .mode-card h3 { font-size: 20px; line-height: 1.25; font-weight: 500; letter-spacing: -0.01em; }
  .mode-card p { font-size: 13px; line-height: 1.5; opacity: 0.85; }
  .sw-cartoon { background: linear-gradient(120deg, #A8D8BC 0% 34%, #C9E6D8 34% 55%, #B9CDF5 55% 100%); }
  .sw-clay { background: linear-gradient(120deg, #E8CBA8 0% 40%, #D6E4C9 40% 62%, #C4D5EE 62% 100%); }
  .sw-satellite { background: linear-gradient(120deg, #55684A 0% 30%, #7A8A5E 30% 52%, #33406B 52% 100%); }
  .sw-photoreal { background: linear-gradient(120deg, #98A6BC 0% 30%, #C3CDDD 30% 58%, #5D6E8C 58% 100%); }

  .feature-row { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .feature-row + .feature-row { margin-top: 84px; }
  .feature-row.flip .feature-art { order: 2; }
  .feature-art {
    background: var(--tf-white); border: 1px solid var(--tf-border);
    border-radius: 16px; padding: 20px; min-height: 220px;
  }

  /* Tags (§5 status tag recipe: radius 999, padding 7x14, ink label 13). */
  .lens-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .chip {
    font-size: 13px; color: var(--tf-ink); padding: 7px 14px;
    border-radius: 999px; border: 1px solid var(--tf-border); background: var(--tf-white);
  }
  .chip.on { background: var(--tf-mint); border-color: var(--tf-mint); font-weight: 500; }
  .dest-line {
    display: flex; justify-content: space-between; padding: 11px 4px;
    border-bottom: 1px solid var(--tf-border); font-size: 15px;
  }
  .dest-line span:last-child { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; opacity: 0.7; align-self: center; }

  .timeline-strip { display: flex; gap: 8px; align-items: stretch; margin-top: 8px; }
  .day-block {
    flex: 1; border-radius: 12px; padding: 10px 10px 12px;
    font-size: 13px; line-height: 1.5; color: var(--tf-ink);
  }
  .day-block b { display: block; font-weight: 600; margin-bottom: 2px; }
  .day-block small { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; }
  .day-stay { background: var(--tf-mint); }
  .day-move { background: var(--tf-sky); }

  .stat-row { display: flex; gap: 44px; margin-top: 28px; flex-wrap: wrap; }
  .stat b {
    display: block; font-size: 34px; line-height: 1.1; font-weight: 600;
    letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
  }
  .stat span { font-size: 13px; opacity: 0.8; }

  /* ---------- about + cta ---------- */
  .about-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; }
  .about-grid p { margin-bottom: 14px; opacity: 0.9; }
  .cta-panel { text-align: center; padding: 92px 24px; border-top: 1px solid var(--tf-border); }
  .cta-panel h2 { margin-bottom: 10px; }
  .cta-panel p { opacity: 0.85; margin-bottom: 28px; }

  footer { border-top: 1px solid var(--tf-border); padding: 34px 0; background: var(--tf-white); }
  .foot-inner { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  footer, footer a { font-size: 13px; opacity: 0.9; }
  footer a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .foot-links { display: flex; gap: 22px; }

  /* ---------- motion (§8: enter 160ms, panels 240ms, nothing longer) ---------- */
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes panel-in-centered-y {
    from { opacity: 0; transform: translateY(calc(-52% + 12px)); }
    to { opacity: 1; transform: translateY(-52%); }
  }
  @keyframes panel-in-centered-x {
    from { opacity: 0; transform: translate(-50%, 12px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .hero-card { animation: panel-in-centered-y var(--panel) var(--ease) backwards; }
  .hero-dock { animation: panel-in-centered-x var(--panel) var(--ease) 120ms backwards; }
  .globe-caption { animation: fade-in var(--panel) var(--ease) 200ms backwards; }
  /* Scroll reveals: tagged from JS so the document is whole without it. */
  .reveal { opacity: 0; }
  .reveal.in { animation: panel-in var(--panel) var(--ease) var(--reveal-delay, 0s) both; }
  .reveal.settled { animation: none; opacity: 1; }

  @media (max-width: 860px) {
    .feature-row, .about-grid { grid-template-columns: 1fr; }
    .feature-row.flip .feature-art { order: 0; }
    .mode-grid { grid-template-columns: repeat(2, 1fr); }
    .dock-links.quiet, .dock-divider { display: none; }
    .globe-caption { display: none; }
    .hero { min-height: 560px; }
    #globeEmbed { top: -20%; height: 140%; left: -30%; width: 160%; }
    .hero-wash {
      background: linear-gradient(180deg,
        rgba(185, 205, 245, 0.85) 0%,
        rgba(185, 205, 245, 0.55) 45%,
        rgba(185, 205, 245, 0.0) 75%);
    }
    .hero-card { top: 84px; transform: none; left: 16px; right: 16px; max-width: none; padding: 24px; animation-name: panel-in; }
  }
  /* §8: under prefers-reduced-motion all movement becomes an opacity
     cross-fade at 120ms. */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .hero-card, .hero-dock, .globe-caption { animation: fade-in 120ms var(--ease) backwards; }
    .reveal.in { animation: fade-in 120ms var(--ease) both; }
    .btn, .mode-card, .btn:hover, .mode-card:hover { transform: none; transition: none; }
  }
</style>
</head>
<body>

<nav>
  <div class="nav-inner">
    <a class="logo" href="/">
      <img src="/mark.svg" alt="" width="30" height="30" />
      <span><span class="wm-tail">tail</span><span class="wm-feathers">Feathers</span></span>
    </a>
  </div>
</nav>

<header class="hero" id="heroSection">
  <div id="globeEmbed"></div>
  <div class="globe-boot" id="globeBoot">LOADING THE WORLD…</div>
  <div class="hero-wash"></div>
  <div class="hero-card">
    <p class="eyebrow">A new way to plan travel</p>
    <h1>Spin the globe.<br /><span class="light">Plan the trip.</span></h1>
    <p class="lede">tailFeathers turns trip planning into play — a living 3D globe with
      curated destinations, real flights and roads, and a timeline you build by touch.
      No spreadsheets. No forty open tabs.</p>
    <div class="hero-cta">
      <a class="btn btn-signal" href="#">Start exploring — it's free</a>
      <a class="btn btn-secondary" href="#modes">See the globe</a>
    </div>
    <p class="hero-note">Runs in your browser · nothing to install</p>
  </div>
  <span class="globe-caption">Live — drag to spin</span>
  <div class="hero-dock">
    <div class="dock-toggle">
      <button class="mode-chip on" type="button" data-mode="clay">Cartoon</button>
      <button class="mode-chip" type="button" data-mode="stylized">Map</button>
    </div>
    <span class="dock-divider"></span>
    <div class="dock-links quiet">
      <a href="#modes">Globe modes</a>
      <a href="#plan">Planning</a>
      <a href="#about">About</a>
    </div>
    <span class="dock-divider"></span>
    <div class="dock-links">
      <a class="dock-login" href="#">Log in</a>
    </div>
    <a class="dock-cta" href="#">Start free</a>
  </div>
</header>

<section id="modes">
  <div class="wrap">
    <p class="eyebrow">Four globes in one</p>
    <h2>Pick the planet that fits your mood</h2>
    <p class="section-lede">Every mode is the same living world — your trips, lenses and
      timeline carry across all of them.</p>
    <div class="mode-grid">
      <div class="mode-card">
        <div class="mode-swatch sw-cartoon"></div>
        <h3>Cartoon terrain</h3>
        <p>Hand-styled mountains and coasts, built live from real elevation data.</p>
      </div>
      <div class="mode-card">
        <div class="mode-swatch sw-clay"></div>
        <h3>Clay</h3>
        <p>A soft, sculpted look you can retune in-app — your globe, your palette.</p>
      </div>
      <div class="mode-card">
        <div class="mode-swatch sw-satellite"></div>
        <h3>Satellite</h3>
        <p>Real imagery when you want to see the actual place from above.</p>
      </div>
      <div class="mode-card">
        <div class="mode-swatch sw-photoreal"></div>
        <h3>Photoreal 3D</h3>
        <p>Fly through cities in full photorealistic 3D before you ever land.</p>
      </div>
    </div>
  </div>
</section>

<section id="plan">
  <div class="wrap">
    <p class="eyebrow">Curated, not crowdsourced</p>

    <div class="feature-row">
      <div>
        <h2>Lenses that answer "where next?"</h2>
        <p class="section-lede" style="margin-bottom:0">Flip on a lens and the globe re-lights
          around it: beaches, food, culture, adventure — filtered by the month you can
          actually travel. Every destination is hand-curated with photos, highlights and
          ready-made itinerary packs.</p>
        <div class="stat-row">
          <div class="stat"><b>2,009</b><span>beaches, ranked</span></div>
          <div class="stat"><b>5</b><span>theme lenses</span></div>
          <div class="stat"><b>12</b><span>months, one filter</span></div>
        </div>
      </div>
      <div class="feature-art">
        <div class="lens-chips">
          <span class="chip on">Beaches</span><span class="chip">Food</span>
          <span class="chip">Culture</span><span class="chip">Adventure</span>
          <span class="chip on">September</span>
        </div>
        <div class="dest-line"><span>Navagio Cove</span><span>36.99° N · RANK 1</span></div>
        <div class="dest-line"><span>Praia da Marinha</span><span>37.09° N · RANK 2</span></div>
        <div class="dest-line"><span>Whitehaven Beach</span><span>20.28° S · RANK 3</span></div>
        <div class="dest-line" style="border:none"><span>Anse Source d'Argent</span><span>4.37° S · RANK 4</span></div>
      </div>
    </div>

    <div class="feature-row flip">
      <div>
        <h2>A timeline you can feel</h2>
        <p class="section-lede" style="margin-bottom:0">Your trip lives on a dock at the bottom
          of the globe. Drag stays to stretch them, tap + to hang a day trip off any stop, and
          watch flights and road routes draw themselves between the days — with real schedules
          and real driving roads, not straight lines.</p>
      </div>
      <div class="feature-art">
        <p class="eyebrow" style="margin-bottom:12px">Trip — Lisbon loop · 9 days</p>
        <div class="timeline-strip">
          <div class="day-block day-stay" style="flex:3"><b>Lisbon</b><small>3 NIGHTS</small></div>
          <div class="day-block day-move" style="flex:1"><b>Drive</b><small>2H 40M</small></div>
          <div class="day-block day-stay" style="flex:2"><b>Lagos</b><small>2 NIGHTS</small></div>
          <div class="day-block day-move" style="flex:1"><b>Flight</b><small>TP 1904</small></div>
          <div class="day-block day-stay" style="flex:3"><b>Madeira</b><small>3 NIGHTS</small></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="about">
  <div class="wrap about-grid">
    <div>
      <p class="eyebrow">About us</p>
      <h2>Built by people who plan trips for fun</h2>
      <p>tailFeathers started with a simple complaint: planning a trip is the best part of
        travelling, and every tool treats it like filing taxes. We wanted the feeling of
        spinning a globe in a library — wonder first, logistics second.</p>
      <p>So we built our own globe engine from scratch, curated every destination by hand, and
        wired in real flight and road data. The result is a planner that feels like a game and
        outputs a trip you can actually take.</p>
    </div>
    <div class="feature-art">
      <p class="eyebrow" style="margin-bottom:14px">Field notes</p>
      <p class="small" style="opacity:0.85">"We rebuilt the coastlines four times until
        the cartoon mode felt right. The Baltic kept turning the wrong shade of blue. Worth it."</p>
      <p class="eyebrow" style="margin-top:14px; opacity:0.6">— the tailFeathers engine team</p>
    </div>
  </div>
</section>

<div class="cta-panel">
  <div class="wrap">
    <h2>The world is loaded. Your move.</h2>
    <p>Free to start — your first trip takes about ten minutes to plan.</p>
    <a class="btn btn-paper" href="#">Create your account</a>
  </div>
</div>

