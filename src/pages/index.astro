---
// Landing page, styled to the tailFeathers design specification v1.0 (pastel)
// with the user-directed "brighter" deviation: butter is the FIELD colour, and
// the primary action inverts to ink fill because butter-on-butter cannot signal.
//
// One deliberate type deviation, documented: the spec's scale tops out at
// Display 34 (it is written for app screens); a marketing hero needs more, so
// the hero headline scales up to 64px while keeping Display's weight (500) and
// tracking (-0.02em). Everything else uses the scale as written.
//
// ⚠ EVERY NUMBER AND CAPABILITY ON THIS PAGE WAS AUDITED AGAINST THE APP ON
// 2026-08-27, AND THE PAGE IS DELIBERATELY NARROWER THAN THE PRODUCT AS A
// RESULT. Things that are built but must NOT be claimed here, with the reason:
//   · "hand-curated" / "chosen by travel experts" — 2 of 3,785 rows carry human
//     verification. The corpus is AI-researched and machine-checked.
//   · "ranked by prominence/popularity" — there is no such measurement; the
//     tiers are editorial priority, which is what the zoom copy says instead.
//   · the "Trending" lens — it is a language model recalling virality from
//     training data, so it is left out of the lens list entirely.
//   · real flight schedules, real train times, real ferry crossings — flights
//     need a Duffel account the public build has no access to, and train/ferry
//     durations are distance formulas the UI does not yet mark as estimates.
//   · saving, accounts, sync, sharing, export — no hosted backend exists, so a
//     trip lasts as long as the tab does. Nothing here promises otherwise.
//   · satellite and photoreal 3D — real, but key-gated and never default-on,
//     and Google's 15,000 tiles/day project ceiling lands around 1,000 users.
//     They are one line in the trust row, not a feature section.
// Driving times and road geometry ARE real (Mapbox, live traffic) in a
// configured build, which is why the drive is the leg the page shows.

// ⚠ THE ONLY TWO SWITCHES THAT CHANGE WHAT THIS PAGE ASKS FOR.
// `appUrl` is null because there is no public address where the app runs today
// (the marketing site is deployed; the product is not). While it is null every
// call to action points at the screenshots below, which is honest and still
// converts. Set it to the real URL and every CTA on the page becomes
// "Open the globe" pointing there — no other edit required.
const appUrl = null;
// Set this to a real address to turn the closing panel into a mailto waitlist.
// Left null deliberately: publishing a personal inbox is the owner's call.
const contactEmail = null;

const isLive = Boolean(appUrl);
const ctaLabel = isLive ? 'Open the globe' : 'See it working';
// ⚠ `#plan`, NOT `#world`, AND THE DESCENT IS WHY. This used to point at a zoom
// pair that sat immediately under the hero. The four-globe descent now occupies
// four and a half viewports of that space, so `#world` would mean "scroll past
// every picture on the page to reach three numbers" — the CTA skipping the exact
// proof it promises. `#plan` is the strongest single capture that is NOT in the
// descent: a real trip, on the real timeline, full width.
const ctaHref = isLive ? appUrl : '#plan';

// ⚠ og:image MUST BE ABSOLUTE. Every social crawler resolves it against its own
// host, not the page's, so a root-relative path silently yields no share card —
// which is exactly how the previous `/og-cover.png` went unnoticed while also
// pointing at a file that did not exist. `Astro.site` comes from
// astro.config.mjs, so this follows the domain when it changes.
const ogImage = new URL('/shots/og-cover.webp', Astro.site).href;

const title = 'tailFeathers — Start with the whole world';
const description =
  'A travel planner you look at. 3,785 places worth going across 205 countries, '
  + 'on a globe you turn with your hand — narrowed to beaches, hikes or history, '
  + 'and to the month you can actually travel.';

const lenses = [
  { name: 'Beaches', count: '2,009' },
  { name: 'History', count: '1,040' },
  { name: 'Bucket list', count: '660' },
  { name: 'Hikes', count: '593' },
  { name: 'Wildlife', count: '463' },
  { name: 'Diving', count: '323' },
  { name: 'Food', count: '169' },
];
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" href="/mark.svg" type="image/svg+xml" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content="The tailFeathers globe tilted low over the Aegean, islands in relief with destinations named across them" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400&display=swap"
  rel="stylesheet"
/>
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "tailFeathers",
  "applicationCategory": "TravelApplication",
  "operatingSystem": "Web",
  "description": "A visual travel planner: turn a 3D globe, browse 3,785 destinations across 205 countries filtered by theme and month, and lay the ones you like out on a timeline.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}
</script>
<style is:global>
  /* ---------- tokens (design spec §2, §3, §8) ---------- */
  :root {
    --tf-ink: #33406B;
    --tf-sky: #B9CDF5;
    --tf-butter: #FFE08A;
    --tf-blush: #FFD0C2;
    --tf-mint: #C9E6D8;
    --tf-mist: #EEF2FB;
    --tf-white: #FFFFFF;
    --tf-border: #E3E9F6;
    /* Brighter direction (user request, deviating from the spec's butter-as-
       signal-only rule): butter is the field colour, with a warm bright paper
       derived from it for the content sections. The primary action inverts to
       ink fill because butter-on-butter cannot signal. */
    --tf-paper: #FFF7E0;
    --tf-border-warm: #F0E2B6;
    --sans: 'Outfit', 'Segoe UI', sans-serif;
    --mono: 'IBM Plex Mono', Consolas, monospace;
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --enter: 160ms;
    --panel: 240ms;
    /* Glass recipe (§4) */
    --glass-fill: linear-gradient(160deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0.32));
    --glass-border: 1px solid rgba(255, 255, 255, 0.75);
    --glass-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 8px 22px rgba(51, 64, 107, 0.10);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--tf-paper);
    color: var(--tf-ink);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; height: auto; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  a:focus-visible, button:focus-visible {
    outline: 2px solid var(--tf-ink); outline-offset: 2px; border-radius: 4px;
  }

  /* ---------- type roles (§3) ---------- */
  .eyebrow {
    font-family: var(--mono); font-size: 11px; line-height: 1.4; font-weight: 400;
    letter-spacing: 0.14em; text-transform: uppercase;
  }
  .small { font-size: 13px; line-height: 1.5; }

  /* ---------- nav: logo + section links, frosts to glass on scroll ---------- */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 10;
    background: transparent; border-bottom: 1px solid transparent;
    transition: background var(--panel) var(--ease), border-color var(--panel) var(--ease), box-shadow var(--panel) var(--ease);
  }
  nav.scrolled {
    background: var(--glass-fill);
    backdrop-filter: blur(20px) saturate(150%);
    border-bottom: var(--glass-border);
    box-shadow: 0 8px 22px rgba(51, 64, 107, 0.10);
  }
  .nav-inner {
    display: flex; align-items: center; height: 68px; gap: 20px;
    padding: 0 clamp(20px, 3vw, 44px);
  }
  /* Wordmark: always "tailFeathers" — tail at 300, Feathers at 600 (§1, §3).
     Gap ≈ 33% of the mark's diameter. */
  .logo { display: flex; align-items: center; gap: 10px; font-size: 21px; line-height: 1; }
  .logo img { width: 30px; height: 30px; }
  .wm-tail { font-weight: 300; }
  .wm-feathers { font-weight: 600; }
  .nav-links { margin-left: auto; display: flex; align-items: center; gap: 4px; }
  .nav-links a {
    font-size: 14px; font-weight: 500; padding: 10px 14px; border-radius: 12px;
    transition: background var(--enter) var(--ease);
  }
  .nav-links a:hover { background: rgba(255, 255, 255, 0.55); }
  /* Before the bar frosts, the links float over the hero's butter field and the
     one nearest the planet loses its contrast. Same butter halo the hero copy
     uses; it disappears once `.scrolled` puts a real surface behind them. */
  nav:not(.scrolled) .nav-links a:not(.nav-cta) {
    text-shadow: 0 0 10px rgba(255, 224, 138, 0.95), 0 0 20px rgba(255, 224, 138, 0.85);
  }

  /* ---------- buttons (§5) ---------- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--sans); font-size: 15px; line-height: 1; font-weight: 500;
    border: none; cursor: pointer; white-space: nowrap;
    transition: transform var(--enter) var(--ease), box-shadow var(--enter) var(--ease), background var(--enter) var(--ease);
  }
  /* Primary on paper: ink fill, white label, radius 14, height 48. */
  .btn-paper {
    background: var(--tf-ink); color: var(--tf-white);
    height: 48px; padding: 0 24px; border-radius: 14px;
  }
  .btn-paper:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(51, 64, 107, 0.18); }
  /* Secondary: 1px ink border, transparent fill. */
  .btn-secondary {
    background: transparent; color: var(--tf-ink);
    border: 1px solid var(--tf-ink);
    height: 48px; padding: 0 22px; border-radius: 14px;
  }
  .btn-secondary:hover { transform: translateY(-1px); background: rgba(255, 255, 255, 0.4); }
  .nav-cta {
    font-size: 14px; font-weight: 500; color: var(--tf-white); background: var(--tf-ink);
    min-height: 40px; display: inline-flex; align-items: center;
    padding: 0 18px; border-radius: 12px; white-space: nowrap;
  }
  .nav-cta:hover { transform: translateY(-1px); }

  /* ======================================================================
     THE DESCENT — four globes you scroll past, in ordinary document flow.

     ⚠ THERE IS NO PINNING, NO CROSS-FADE AND NO SCROLL DRIVER, AND THAT IS
     THE DESIGN RATHER THAN A SIMPLIFICATION. The first build of this section
     was a `position: sticky` stage whose four layers cross-faded on scroll
     progress. It was rejected on sight — "it's tabbed" — and the diagnosis is
     right: two layers swapping inside a frame that does not move is a
     slideshow, and no easing curve turns a slideshow into a descent. Parallax
     would be the same trick wearing a different hat. What follows is four
     objects laid down the page, and the reader's own scroll moves past them.

     Stop 0 is the live WebGL globe. Stops 1-3 are real app captures at
     successive altitudes — they compose because they ARE one flight, shot as
     one. `roads.webp` (flat Map mode, no limb) and `timeline.webp` (a UI) are
     deliberately not here; either one breaks the read, so they stay as
     ordinary sections below.

     Everything is plain CSS, so this section is identical with JavaScript
     disabled, under `prefers-reduced-motion`, and to a crawler.
     ====================================================================== */
  .descent { position: relative; background: var(--tf-butter); }

  /* --- stop 0: a COMPLETE sphere, half of it below the first screen ------ */
  /* ⚠ `top` AND `height` ARE IN vh, NOT PERCENT, AND THAT IS LOAD-BEARING.
     The requirement is a whole planet whose EQUATOR sits on the fold: one
     object, complete, with only its top half on the first screen. That fixes
     the sphere's centre at exactly 100vh from the top of the page — a spec,
     not a look, and one the harness asserts rather than eyeballs.

     Percent units would measure against `.stop-hero`, so the centre would
     drift every time the hero's height changed and the spec would quietly
     stop holding. In vh the arithmetic is visible: the sphere's centre is
     `top + height/2` = 38 + 62 = 100vh, full stop.

     ⚠ THE PLANET'S SIZE IS `SPHERE_FILL` IN hero-globe.js, NOT ANYTHING HERE.
     The projection is a vertical-FOV perspective, so the sphere's diameter is
     `SPHERE_FILL × this element's HEIGHT` = 0.74 × 124vh = 91.8vh. Its top
     edge lands at 54.1vh (just under the hero copy) and its bottom at 145.9vh,
     which is what `.stop-hero`'s height has to clear.

     ⚠ THE WIDTH CONSTRAINT GOT TIGHTER WHEN THE SPHERE BECAME COMPLETE. The
     old cropped-cap hero only had to fit its visible ARC; a whole planet has
     to fit its whole DIAMETER, so the rule is `0.918 × H ≤ W`, i.e. any
     viewport at least as wide as it is tall. Portrait is handled at the foot
     of this stylesheet. `width: 100vh` is the narrowest container that still
     holds a 91.8vh sphere — and it is a third of the fragments the previous
     oversized hero rasterised every frame. */
  .stop-hero {
    position: relative; overflow: hidden;
    height: 154vh;
    background: var(--tf-butter);
  }
  #globeEmbed {
    position: absolute; top: 38vh; height: 124vh;
    left: 50%; transform: translateX(-50%); width: 100vh;
  }
  .hero-card {
    position: absolute; z-index: 3;
    top: clamp(88px, 11vh, 128px);
    left: 50%; transform: translateX(-50%);
    width: calc(100% - 48px); max-width: 640px;
    text-align: center;
    /* The block ignores the pointer; only the buttons and links catch input. */
    pointer-events: none;
  }
  .hero-card .lede { margin: 0 auto; }
  .hero-card .hero-cta { justify-content: center; }
  .hero-card a, .hero-card .btn { pointer-events: auto; }
  .hero-card .eyebrow { color: var(--tf-ink); opacity: 0.75; }
  /* A butter halo hugging the letterforms: invisible butter-on-butter, and the
     only thing keeping the copy legible where a short viewport pushes it onto
     the planet's apex. This replaced a full-width butter veil, which the
     geometry no longer needs — with the sphere's centre at 100vh its top edge
     clears the copy on every shape but a landscape phone. */
  .hero-card h1, .hero-card .lede, .hero-card .eyebrow, .hero-card .hero-note {
    text-shadow:
      0 1px 0 rgba(255, 224, 138, 0.9),
      0 0 10px rgba(255, 224, 138, 0.95),
      0 0 22px rgba(255, 224, 138, 0.8);
  }
  h1 {
    font-size: clamp(40px, 5vw, 64px); line-height: 1.08;
    font-weight: 500; letter-spacing: -0.02em; text-wrap: balance;
    margin: 14px 0 16px;
  }
  h1 .light { font-weight: 300; }
  .lede { font-size: 17px; max-width: 27em; }
  .lede b { font-weight: 600; }
  .hero-cta { display: flex; gap: 12px; margin-top: 26px; align-items: center; flex-wrap: wrap; }
  .hero-note { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.65; margin-top: 18px; }

  /* --- stops 1-3: one screen each, full bleed ------------------------- */
  .stop-shot { position: relative; height: 100vh; overflow: hidden; background: var(--tf-butter); }
  .stop-shot .stop-art { position: absolute; inset: 0; }
  .stop-shot .stop-art img { width: 100%; height: 100%; object-fit: cover; }

  /* ⚠ THE SCALES ARE FRAMING, NOT MOTION — THEY ARE STATIC AND EACH ONE PAYS
     FOR ITSELF.

     Stops 2 and 3 scale about their TOP edge. These are screenshots of a
     running app, so the bottom ~7% of each frame is the trip dock and the
     attribution strip; full-bleed, that reads as a UI bar sliced off
     mid-glyph. 1.10 crops 10% off the foot, which clears it, and cropping
     from the top instead would eat the planet's limb — the whole reason these
     read as globes rather than as maps. `object-position: 50% 0` makes the
     cover crop take from the bottom too, for the same reason. */
  .stop-shot .stop-art img { transform: scale(1.10); transform-origin: 50% 0; object-position: 50% 0; }
  /* Stop 1 is the exception in both directions. world.webp is a small disc in
     a lot of empty sky — about a third the width of the sphere above it — so
     at scale 1 scrolling from stop 0 to stop 1 reads as flying BACKWARDS.
     1.6 tracks the sphere's on-screen size to within a few percent across
     16:10, 16:9 and 4:3, crops the app's chrome out on all four sides, and
     still does not upscale: the asset is re-encoded from the 2880px capture
     precisely so this scale is free. */
  .stop-shot[data-stop='1'] .stop-art img {
    transform: scale(1.6); transform-origin: 50% 50%; object-position: 50% 50%;
  }

  .stop-caption {
    position: absolute; z-index: 3;
    left: clamp(24px, 5vw, 72px); bottom: clamp(44px, 9vh, 92px);
    width: min(430px, calc(100% - 48px));
    /* ⚠ DENSER THAN THE §4 GLASS RECIPE, AND MEASURED THAT WAY. The spec's
       0.68→0.32 fill is authored for glass over the APP's pastel sky. Here it
       sits over a photograph of forest and coastline, and the third line — the
       one carrying the place names — fell to roughly 2.5:1 against pale sand.
       This keeps the gradient and the blur and lifts the floor to 0.74, which
       clears 4.5:1 on all three captures. */
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.74));
    backdrop-filter: blur(20px) saturate(150%);
    border: var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: 20px; padding: 22px 24px 24px;
  }
  .stop-caption .eyebrow { opacity: 0.7; margin-bottom: 10px; }
  .stop-caption h2 { font-size: clamp(24px, 2.6vw, 32px); margin-bottom: 8px; }
  .stop-caption p { font-size: 15px; }

  /* ---------- the thesis strip, immediately below the descent ---------- */
  .thesis { background: var(--tf-ink); color: var(--tf-white); padding: 56px 0; }
  .thesis p { font-size: clamp(20px, 2.4vw, 28px); line-height: 1.3; font-weight: 300; letter-spacing: -0.01em; text-wrap: balance; max-width: 30em; }
  .thesis p b { font-weight: 500; }
  .thesis .eyebrow { opacity: 0.6; margin-bottom: 14px; }

  /* ---------- paper sections (§4: elevation = border, no shadow) ---------- */
  /* ⚠ THE NAV IS FIXED, SO EVERY IN-PAGE ANCHOR LANDS 68px SHORT WITHOUT THIS.
     It matters more than it used to: with no public app URL the primary call to
     action is itself an anchor (`#plan`), so anchor-landing is now the main way
     people move through the page, not an afterthought. */
  section { padding: 88px 0; scroll-margin-top: 84px; }
  section + section { border-top: 1px solid var(--tf-border-warm); }
  section .eyebrow { opacity: 0.75; margin-bottom: 12px; }
  h2 {
    font-size: clamp(26px, 3vw, 34px); line-height: 1.15;
    font-weight: 500; letter-spacing: -0.02em; text-wrap: balance;
    margin-bottom: 12px;
  }
  .section-lede { max-width: 34em; margin-bottom: 36px; opacity: 0.88; font-size: 16px; }

  /* ---------- screenshots ---------- */
  .shot {
    border: 1px solid var(--tf-border-warm); border-radius: 16px;
    overflow: hidden; background: var(--tf-white);
  }
  .shot img { width: 100%; }
  .shot-cap {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em;
    text-transform: uppercase; opacity: 0.6; margin-top: 10px;
  }
  .feature-row { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 52px; align-items: center; }
  /* The columns swap with the order, so the screenshot keeps the wider half
     whichever side it sits on. */
  .feature-row.flip { grid-template-columns: 1.15fr 0.85fr; }
  .feature-row.flip .feature-art { order: -1; }

  /* The lens block carries no screenshot — the globes above already showed the
     lens on, and the chips ARE the picture. Centred so it does not read as a
     column missing its other half. */
  .lens-block { text-align: center; }
  .lens-block .section-lede { margin-left: auto; margin-right: auto; margin-bottom: 28px; }
  .lens-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 8px; }
  .lens-block .lens-chips, .lens-block .months { justify-content: center; }
  .chip {
    font-size: 14px; color: var(--tf-ink); padding: 9px 16px;
    border-radius: 999px; border: 1px solid var(--tf-border-warm); background: var(--tf-white);
    display: inline-flex; gap: 8px; align-items: baseline;
  }
  .chip.on { background: var(--tf-butter); border-color: var(--tf-butter); font-weight: 500; }
  .chip span { font-family: var(--mono); font-size: 11px; opacity: 0.65; }
  .months { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 16px; }
  .month {
    font-family: var(--mono); font-size: 11px; width: 30px; height: 30px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 8px; border: 1px solid var(--tf-border-warm); background: var(--tf-white);
  }
  .month.on { background: var(--tf-butter); border-color: var(--tf-butter); font-weight: 600; }

  .stat-row { display: flex; gap: 40px; margin-top: 26px; flex-wrap: wrap; }
  .stat b {
    display: block; font-size: 32px; line-height: 1.1; font-weight: 600;
    letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
  }
  .stat span { font-size: 13px; opacity: 0.8; }

  .plan-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 30px; }
  .step-card {
    background: var(--tf-white); border: 1px solid var(--tf-border-warm);
    border-radius: 16px; padding: 16px 18px 20px;
  }
  .step-card h3 { font-size: 18px; line-height: 1.25; font-weight: 500; letter-spacing: -0.01em; margin-bottom: 6px; }
  .step-card p { font-size: 13px; line-height: 1.5; opacity: 0.85; }

  /* ---------- the late trust row: every technical fact, one line each ------ */
  .trust { background: var(--tf-white); }
  .trust-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 52px; }
  .trust-item { padding: 16px 0; border-bottom: 1px solid var(--tf-border); display: flex; gap: 16px; }
  .trust-item b { font-weight: 500; flex: 0 0 auto; min-width: 8.5em; }
  .trust-item span { opacity: 0.82; font-size: 14px; }

  /* ---------- closing ---------- */
  .cta-panel { text-align: center; padding: 92px 24px; border-top: 1px solid var(--tf-border-warm); background: var(--tf-butter); }
  .cta-panel h2 { margin-bottom: 10px; }
  .cta-panel p { opacity: 0.85; margin: 0 auto 28px; max-width: 34em; }

  footer { border-top: 1px solid var(--tf-border-warm); padding: 34px 0; background: var(--tf-white); }
  .foot-inner { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap; }
  footer, footer a { font-size: 13px; opacity: 0.9; }
  footer a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .foot-links { display: flex; gap: 22px; }
  .foot-credit { max-width: 46em; opacity: 0.7; line-height: 1.6; }

  /* ---------- motion (§8: enter 160ms, panels 240ms, nothing longer) ------ */
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  /* ⚠ THE TRANSFORM HAS TO CARRY THE CENTRING. `.hero-card` is centred with
     `translateX(-50%)`; a keyframe that animates plain `translateY` would drop
     that and slam the card half a viewport to the right for its duration. */
  @keyframes panel-in-centered-x {
    from { opacity: 0; transform: translateX(-50%) translateY(12px); }
    to { opacity: 1; transform: translateX(-50%); }
  }
  /* Same rule, both axes — for the narrow layout, where the copy is centred in
     the band between the nav and the planet rather than hung from the top. */
  @keyframes panel-in-centered-xy {
    from { opacity: 0; transform: translate(-50%, calc(-50% + 12px)); }
    to { opacity: 1; transform: translate(-50%, -50%); }
  }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  .hero-card { animation: panel-in-centered-x var(--panel) var(--ease) backwards; }
  /* Scroll reveals: tagged from JS so the document is whole without it. */
  .reveal { opacity: 0; }
  .reveal.in { animation: panel-in var(--panel) var(--ease) var(--reveal-delay, 0s) both; }
  .reveal.settled { animation: none; opacity: 1; }

  /* ⚠ THE HERO COPY HAS TO ANSWER TO VIEWPORT HEIGHT, BECAUSE THE PLANET'S
     APEX IS PINNED TO IT. The sphere's centre is fixed at 100vh, so its top
     edge lands at `100vh - 45.9vh` — a fixed FRACTION of the screen — while the
     copy above it is sized in px and vw and does not shrink when the screen
     gets shorter. Measured on a 768-tall laptop the two collided by 47px: the
     note and half the button row sat on the planet's cap. Trimming the type on
     short viewports is what buys the clearance back; every number below was
     picked to land the gap positive at 1366×768 and 1024×768, the two shapes
     that failed. Screens over 940px tall keep the full 64px display size. */
  @media (max-height: 940px) and (min-aspect-ratio: 1/1) {
    .hero-card { top: clamp(80px, 9vh, 96px); }
    h1 { font-size: clamp(34px, 4.4vw, 48px); margin: 10px 0 12px; }
    .lede { font-size: 16px; }
    .hero-cta { margin-top: 18px; }
    .hero-note { margin-top: 12px; }
  }

  /* Layout collapse is a WIDTH question — two columns stop working when there
     is not room for two columns. The globe is not in here; see below. */
  @media (max-width: 900px) {
    .feature-row { grid-template-columns: 1fr; gap: 28px; }
    .feature-row.flip .feature-art { order: 0; }
    .plan-steps { grid-template-columns: 1fr; }
    .trust-grid { grid-template-columns: 1fr; }
    .nav-links a:not(.nav-cta) { display: none; }
  }

  /* ⚠ THE DESCENT'S BREAKPOINT IS ASPECT, NOT WIDTH, AND WRITING IT AS
     `max-width: 900px` ALONE SHIPS TWO REAL BUGS. An iPad Pro portrait is
     1024×1366 CSS px — wider than 900 — so a width-only rule would give it the
     desktop treatment, where:

       · the complete sphere is 0.918 × 1366 = 1254px inside a 1024-wide
         viewport. It is no longer a whole object, which is the one thing this
         hero is required to be.
       · a 16:10 capture full-bleed in a portrait frame is a vertical slice of
         terrain with the limb cropped away — the globes stop being globes.

     So every viewport at least as tall as it is wide lands here and gets a
     smaller sphere plus the captures in cards. Same rule, both problems.

     The sphere's centre stays at 100vh: the spec holds on a phone too. Only
     the diameter changes — 0.40 × H, which is 338px inside a 390px viewport
     and 546 inside a 1024. */
  @media (max-width: 900px), (max-aspect-ratio: 1/1) {
    .stop-hero { height: 128vh; min-height: 620px; }
    #globeEmbed { top: 73vh; height: 54vh; width: 100%; }
    /* ⚠ CENTRED IN THE BAND, NOT HUNG FROM THE TOP, AND THE TALLER THE SCREEN
       THE MORE IT MATTERS. The planet's apex is pinned at `100vh - 20vh` = 80vh
       whatever the shape, so a fixed `top: 88px` leaves a gap below the copy
       that grows with the viewport: 176px of dead butter on a phone, 553px on a
       portrait tablet. This puts the card in the middle of the band between the
       nav's foot (68px) and that apex, which balances both gaps on every
       narrow shape measured. The keyframe has to change with it — a transform
       that animates only Y would drop the horizontal centring. */
    .hero-card { top: calc(34px + 40vh); transform: translate(-50%, -50%);
      animation-name: panel-in-centered-xy; }

    .stop-shot {
      height: auto; overflow: visible;
      background: var(--tf-paper); padding: 56px 0;
      border-top: 1px solid var(--tf-border-warm);
    }
    .stop-shot .stop-art,
    .stop-shot[data-stop='1'] .stop-art { position: static; }
    /* Undo the full-bleed framing wholesale: in a card the app's dock is part
       of the picture rather than a bar sliced off the foot of the screen. */
    .stop-shot .stop-art img,
    .stop-shot[data-stop='1'] .stop-art img {
      width: 100%; height: auto; transform: none; object-fit: fill;
      border-radius: 16px; border: 1px solid var(--tf-border-warm);
    }
    .stop-caption {
      position: static; width: auto; max-width: 34em;
      margin: 0 auto 24px; background: none; backdrop-filter: none;
      border: 0; box-shadow: none; padding: 0;
    }
    .stop-caption p { font-size: 16px; opacity: 0.88; }
  }

  /* §8: under prefers-reduced-motion all movement becomes an opacity
     cross-fade at 120ms. The descent needs nothing here — it has no motion of
     its own, only the reader's scroll. */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .hero-card { animation: fade-in 120ms var(--ease) backwards; }
    .reveal.in { animation: fade-in 120ms var(--ease) both; }
    .btn, .btn:hover { transform: none; transition: none; }
  }
</style>
</head>
<body>

<nav>
  <div class="nav-inner">
    <a class="logo" href="/">
      <img src="/mark.svg" alt="" width="30" height="30" />
      <span><span class="wm-tail">tail</span><span class="wm-feathers">Feathers</span></span>
    </a>
    <div class="nav-links">
      <a href="#world">The world</a>
      <a href="#lenses">Lenses</a>
      <a href="#plan">Planning</a>
      <a class="nav-cta" href={ctaHref}>{ctaLabel}</a>
    </div>
  </div>
</nav>

<div class="descent">

  <section class="stop-hero" data-stop="0">
    <div class="stop-art"><div id="globeEmbed"></div></div>
    <div class="hero-card">
      <p class="eyebrow">A travel planner you look at</p>
      <h1>Start with the<br /><span class="light">whole world.</span></h1>
      <p class="lede">Most planners open with a box asking where you're going. tailFeathers
        opens with <b>3,785 places worth going</b>, across 205 countries, on a globe you turn
        with your hand.</p>
      <div class="hero-cta">
        <a class="btn btn-paper" href={ctaHref}>{ctaLabel}</a>
        <a class="btn btn-secondary" href="#lenses">Browse by what you like</a>
      </div>
      <p class="hero-note">Free · runs in your browser · no account</p>
    </div>
  </section>

  <section class="stop-shot" data-stop="1">
    <div class="wrap">
      <div class="stop-caption">
        <p class="eyebrow">The world view</p>
        <h2>Twenty-nine places to start</h2>
        <p>The ones everyone already knows — sitting where they actually are, not
          listed down a column.</p>
      </div>
      <div class="stop-art">
        <img
          src="/shots/world.webp"
          alt="The tailFeathers globe at world view, about two dozen destination markers scattered across Europe, Africa and the Americas"
          width="2880" height="1800" decoding="async" loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="stop-shot" data-stop="2">
    <div class="wrap">
      <div class="stop-caption">
        <p class="eyebrow">One lean-in later</p>
        <h2>Come closer and the rest unfold</h2>
        <p>The regional headliners, then a country's own classics, then the things only
          locals name: Meteora, Rila Monastery, Belogradchik Rocks, Ksamil.</p>
      </div>
      <div class="stop-art">
        <img
          src="/shots/region.webp"
          alt="The globe tilted over south-east Europe, hundreds of named destination markers covering Greece, the Balkans, Romania and Turkey"
          width="1800" height="1125" decoding="async" loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="stop-shot" data-stop="3">
    <div class="wrap">
      <div class="stop-caption">
        <p class="eyebrow">Beaches lens on</p>
        <h2>Down to one sea at a time</h2>
        <p>Switch on a lens and the globe re-lights around it. What's left is a shortlist
          you can look at instead of read.</p>
      </div>
      <div class="stop-art">
        <img
          src="/shots/islands.webp"
          alt="The globe tilted low over the Aegean, islands and coastline in relief, with Athens, Mykonos, Naxos, Meteora and Ephesus marked"
          width="1800" height="1125" decoding="async" loading="lazy"
        />
      </div>
    </div>
  </section>

</div>

<div class="thesis">
  <div class="wrap">
    <p class="eyebrow">The part nobody helps with</p>
    <p>Choosing <b>where</b> is the hard part, and it is the one part every other
      planner assumes you have already done.</p>
  </div>
</div>

<section id="world">
  <div class="wrap">
    <p class="eyebrow sec-head">What is actually on it</p>
    <h2 class="sec-head">Three thousand seven hundred and eighty-five places</h2>
    <p class="section-lede sec-head">All of them travel inside the app rather than arriving
      from a server, so browsing costs nothing, works on a plane, and asks for nobody's
      account. Nothing you look at is being counted.</p>

    <div class="stat-row">
      <div class="stat"><b>3,785</b><span>places, in 205 countries</span></div>
      <div class="stat"><b>2,620</b><span>with a credited photograph</span></div>
      <div class="stat"><b>3,746</b><span>with a line on why to go</span></div>
    </div>
  </div>
</section>

<section id="lenses">
  <div class="wrap lens-block">
    {/* SEVEN, not eight. The app ships an eighth themed filter called
        "Trending", which is a language model recalling virality from its
        training data rather than any measurement — so it is left off the
        page, and the count is written to match the chips a reader can
        actually count below. */}
    <p class="eyebrow sec-head">Seven lenses and a month</p>
    <h2 class="sec-head">Narrow it to what you actually like</h2>
    <p class="section-lede sec-head">Switch on beaches and the globe re-lights around 2,009
      of them. Switch on hikes, or history, or diving, and it re-lights again. Add the month
      you can genuinely get away and what's left is a shortlist you can look at.</p>

    <div class="lens-chips sec-head">
      {lenses.map((lens) => (
        <span class:list={['chip', lens.name === 'Beaches' && 'on']}>
          {lens.name} <span>{lens.count}</span>
        </span>
      ))}
    </div>
    <div class="months sec-head">
      {['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'].map((m, i) => (
        <span class:list={['month', i === 8 && 'on']}>{m}</span>
      ))}
    </div>
  </div>
</section>

<section id="plan">
  <div class="wrap">
    <p class="eyebrow sec-head">When you've picked a few</p>
    <h2 class="sec-head">Lay them out as days</h2>
    <p class="section-lede sec-head">The timeline docks under the globe and the stops sit
      on it in order, each carrying its own photograph. Give a stop its nights, hang a day
      trip off it, note where you're staying and where you're eating. A running count in
      the corner tells you what you still haven't decided.</p>

    <div class="shot"><img src="/shots/timeline.webp" alt="The tailFeathers timeline docked under the globe with three stops — Athens, Delphi and Meteora — each on a photographed card, car icons marking the legs between them" width="1800" height="1125" loading="lazy" /></div>
    <p class="shot-cap">A three-stop run through mainland Greece</p>

    <div class="plan-steps">
      <div class="step-card">
        <h3>Stops in order</h3>
        <p>Add a place from the globe or from search and it slots into the sequence,
          with the journey rewired around it.</p>
      </div>
      <div class="step-card">
        <h3>Days hung off days</h3>
        <p>A day trip pins under the stop it belongs to, so the shape of the main route
          stays readable.</p>
      </div>
      <div class="step-card">
        <h3>What's still open</h3>
        <p>Stops without dates, legs without a way to travel them, nights with nowhere to
          sleep — counted, not buried.</p>
      </div>
    </div>
  </div>
</section>

<section id="roads">
  <div class="wrap">
    <div class="feature-row flip">
      <div>
        <p class="eyebrow sec-head">The drive you're signing up for</p>
        <h2 class="sec-head">Real roads, not a line through the hills</h2>
        <p class="section-lede sec-head" style="margin-bottom:0">Set a leg to drive and the
          actual road route draws itself across the map, with a drive time that accounts
          for today's traffic. Athens to Delphi is two hours twenty-one — north out of the
          city, then west along the gulf. You can see why before you commit to it.</p>
        <p class="small" style="margin-top:18px; opacity:0.7">Flights, trains and ferries
          are placed as estimates from distance, so you can block out the day — not as
          timetables. tailFeathers plans trips; it doesn't sell tickets.</p>
      </div>
      <div class="feature-art">
        <div class="shot"><img src="/shots/roads.webp" alt="A road route drawn in orange from Athens to Delphi across the dark map globe, following the real highway north and west along the Gulf of Corinth" width="1800" height="1125" loading="lazy" /></div>
        <p class="shot-cap">Athens → Delphi · 2 h 21 m by road</p>
      </div>
    </div>
  </div>
</section>

<section class="trust">
  <div class="wrap">
    <p class="eyebrow sec-head">Where all this comes from</p>
    <h2 class="sec-head">The unglamorous half</h2>
    <p class="section-lede sec-head">Because you should know what you are looking at.</p>
    <div class="trust-grid">
      <div class="trust-item">
        <b>The terrain</b>
        <span>Sculpted live from open global elevation and OpenStreetMap — free, keyless,
          and streamed as you fly. Twenty-one dials if you want to retune the look.</span>
      </div>
      <div class="trust-item">
        <b>The places</b>
        <span>Researched with AI, then machine-checked: 3,147 of 3,785 had their
          coordinates confirmed against Google's geocoder. Not hand-picked by editors —
          we'd rather say so.</span>
      </div>
      <div class="trust-item">
        <b>The photographs</b>
        <span>Freely licensed images from Wikimedia contributors, each credited on the
          card it appears on. About seven places in ten have one.</span>
      </div>
      <div class="trust-item">
        <b>The months</b>
        <span>A twelve-month suitability rating per place, generated rather than measured.
          Treat it as a starting point, not a forecast.</span>
      </div>
      <div class="trust-item">
        <b>Driving times</b>
        <span>Real routing over the real road network, with live traffic. Train, ferry and
          flight durations are distance estimates until you pick a specific service.</span>
      </div>
      <div class="trust-item">
        <b>Other globes</b>
        <span>Satellite imagery and photorealistic 3D exist behind a tap, where coverage
          allows. The illustrated map and the sculpted globe are the two that are always
          there.</span>
      </div>
      <div class="trust-item">
        <b>Your trip</b>
        <span>Lives in the tab while you work. There are no accounts and no sync yet, so
          nothing leaves your browser — and nothing is kept when you close it.</span>
      </div>
      <div class="trust-item">
        <b>The price</b>
        <span>Nothing, and no payments anywhere in the product. When you book, you book on
          the provider's own site.</span>
      </div>
    </div>
  </div>
</section>

<div class="cta-panel">
  <div class="wrap">
    {isLive ? (
      <>
        <h2>The world is loaded.</h2>
        <p>Free, in your browser, with nothing to sign up for.</p>
        <a class="btn btn-paper" href={appUrl}>Open the globe</a>
      </>
    ) : (
      <>
        <h2>Not open to the public yet.</h2>
        <p>tailFeathers runs, it's free, and it will stay free — but there's no public
          address to send you to today. Everything above is the real thing, photographed
          as it stands.</p>
        {/* One CTA string, repeated verbatim, bookending the page — which is
            what every strong page in the comparison set does. With no address
            to send anyone to, the honest version of that string points back at
            the proof. */}
        {contactEmail
          ? <a class="btn btn-paper" href={`mailto:${contactEmail}?subject=tailFeathers%20early%20access`}>Get early access</a>
          : <a class="btn btn-paper" href={ctaHref}>{ctaLabel}</a>}
      </>
    )}
  </div>
</div>

<footer>
  <div class="wrap foot-inner">
    <div>
      <p>© 2026 tailFeathers.</p>
      <p class="foot-credit">Map data © OpenStreetMap contributors, served via OpenFreeMap
        and OpenMapTiles. Elevation from Tilezen / Joerd contributors. Contains modified
        Copernicus Service Information 2019. Destination photographs by their individual
        Wikimedia Commons authors, credited in the app.</p>
    </div>
    <div class="foot-links">
      <a href="#world">The world</a><a href="#lenses">Lenses</a><a href="#plan">Planning</a>
    </div>
  </div>
</footer>

<script>
  // ⚠ THE HERO IS A BAKED TEXTURE ON A SPHERE, NOT THE ENGINE. It used to mount
  // TravelApp's real cartoon engine: 735 MB of tiles and datasets in public/,
  // and a "LOADING THE WORLD…" placard over a ~6.4 s boot, to render a planet
  // the page deliberately let nobody zoom. It is now 0.17 MB and on screen in
  // the first frame. Regenerate the texture from the TravelApp repo whenever
  // the look changes:
  //   cd ../TravelApp/globe_src
  //   node scripts/bake-hero-globe.mjs
  //   node scripts/png-to-webp.mjs build/hero-globe.2048.png
  //   cd ../../tail-feathers-site && npm run sync-hero
  //
  // The three globes below it in the descent are the opposite trade: those ARE
  // the engine, captured from the built app by globe_src/scripts/shot-marketing.mjs.
  //
  // ⚠ THERE IS DELIBERATELY NO SCROLL DRIVER HERE. The descent is four objects
  // in ordinary document flow; the reader's scroll is the whole animation. An
  // earlier build pinned a stage and cross-faded between the four on scroll
  // progress, which reads as a slideshow rather than a descent — see the block
  // comment above `.descent` in the stylesheet before reaching for that again.
  //
  // ⚠ THIS TAG CARRIES NO ATTRIBUTES, AND THAT IS LOAD-BEARING. Astro only
  // bundles a `<script>` that has none of its own — `is:inline` opts out, and so
  // does a bare `type="module"`. With either one present Astro emits the source
  // VERBATIM, the browser resolves `../scripts/hero-globe.js` against the page
  // URL, 404s, and the module never runs: no error on screen, no canvas, just a
  // hero with an empty right half. Measured here, exactly that way.
  import { mountHeroGlobe } from '../scripts/hero-globe.js';

  mountHeroGlobe(document.getElementById('globeEmbed'), {
    texture: '/hero/globe.webp',
    clouds: '/hero/clouds.webp',
  });

  // The header floats transparent over the hero; past the hero's foot it needs
  // a surface of its own to stay readable over the page content.
  const navBar = document.querySelector('nav');
  addEventListener('scroll', () => {
    navBar.classList.toggle('scrolled', scrollY > 40);
  }, { passive: true });

  // ---------- scroll motion (spec §8: 240ms panels, reduced-motion handled
  // in CSS as a 120ms fade) ----------
  // Reveal classes are applied FROM JS so the document is complete without it.
  // ⚠ NOTHING INSIDE `.descent` IS TAGGED. Those four screens are the page's
  // proof; hiding them behind a script until an observer fires would put the
  // whole argument at the mercy of one failed module fetch.
  if ('IntersectionObserver' in window) {
    const targets = document.querySelectorAll(
      '.sec-head, .stat-row > *, .plan-steps > *, .feature-row > *, ' +
        '#plan > .wrap > .shot, .trust-item, .cta-panel h2, .cta-panel p, .cta-panel .btn',
    );
    for (const el of targets) {
      el.classList.add('reveal');
      // Clear the finished animation so its forwards-fill cannot pin transforms.
      el.addEventListener('animationend', () => el.classList.add('settled'), { once: true });
    }
    document.querySelectorAll('.plan-steps .step-card').forEach((el, i) => {
      el.style.setProperty('--reveal-delay', `${i * 60}ms`);
    });
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.1, rootMargin: '0px 0px -48px 0px' },
    );
    for (const el of targets) io.observe(el);
  }
</script>
</body>
</html>
