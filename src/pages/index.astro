<script>
  // ⚠ THE HERO NO LONGER MOUNTS THE ENGINE. It used to import the built cartoon
  // bundle from /globe and drive it with setMode/flyTo/setAutoRotate — 735 MB of
  // tiles and datasets in public/, and a "LOADING THE WORLD…" placard over a
  // ~6.4 s boot, to render a planet the page deliberately let nobody zoom.
  //
  // It is now one baked texture (0.17 MB) on a sphere. Regenerate the texture
  // from the TravelApp repo whenever the look changes:
  //   cd ../TravelApp/globe_src
  //   node scripts/bake-hero-globe.mjs --out ../../tail-feathers-site/public/hero
  //   node scripts/png-to-webp.mjs ../../tail-feathers-site/public/hero/hero-globe.2048.png
  //
  // ⚠ THIS TAG CARRIES NO ATTRIBUTES, AND THAT IS LOAD-BEARING. Astro only
  // bundles a `<script>` that has none of its own — `is:inline` opts out, and so
  // does a bare `type="module"`. With either one present Astro emits the source
  // VERBATIM, the browser resolves `../scripts/hero-globe.js` against the page
  // URL, 404s, and the module never runs: no error on screen, no canvas, just a
  // hero with an empty right half. Measured here, exactly that way.
  // Astro's own output is a module, so nothing is lost by omitting the type.
  import { mountHeroGlobe } from '../scripts/hero-globe.js';

  mountHeroGlobe(document.getElementById('globeEmbed'), {
    texture: '/hero/globe.webp',
  });

  // The header floats transparent over the hero; past the hero's foot it needs
  // a surface of its own to stay readable over the page content.
  const navBar = document.querySelector('nav');
  addEventListener('scroll', () => {
    navBar.classList.toggle('scrolled', scrollY > 40);
  }, { passive: true });

  // ---------- the timeline editor demo ----------
  // The two signature interactions, real on the page: drag a stay's edge to
  // trade nights with its neighbour, tap + to hang a day trip off a stop.
  {
    const lisbon = document.getElementById('stayLisbon');
    const lagos = document.getElementById('stayLagos');
    const lisbonLabel = document.getElementById('lisbonNights');
    const lagosLabel = document.getElementById('lagosNights');
    const handle = document.getElementById('lisbonHandle');
    const SHARED_NIGHTS = 5; // Lisbon + Lagos trade within this pool
    const PX_PER_NIGHT = 48;
    let nights = 3;
    const nightsText = (n) => `${n} NIGHT${n === 1 ? '' : 'S'}`;
    const apply = () => {
      lisbon.style.flex = String(nights);
      lagos.style.flex = String(SHARED_NIGHTS - nights);
      lisbonLabel.textContent = nightsText(nights);
      lagosLabel.textContent = nightsText(SHARED_NIGHTS - nights);
    };
    let dragFromX = null;
    let dragFromNights = nights;
    handle.addEventListener('pointerdown', (event) => {
      dragFromX = event.clientX;
      dragFromNights = nights;
      handle.setPointerCapture(event.pointerId);
    });
    handle.addEventListener('pointermove', (event) => {
      if (dragFromX === null) return;
      const moved = Math.round((event.clientX - dragFromX) / PX_PER_NIGHT);
      nights = Math.min(4, Math.max(1, dragFromNights + moved));
      apply();
    });
    for (const end of ['pointerup', 'pointercancel']) {
      handle.addEventListener(end, () => { dragFromX = null; });
    }
    handle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      nights = Math.min(4, Math.max(1, nights + (event.key === 'ArrowRight' ? 1 : -1)));
      apply();
    });

    const addButton = document.getElementById('addDayTrip');
    const dayTrip = document.getElementById('dayTrip');
    addButton.addEventListener('click', () => {
      const showing = dayTrip.hidden;
      dayTrip.hidden = !showing;
      addButton.textContent = showing ? '×' : '+';
      addButton.setAttribute('aria-expanded', String(showing));
      addButton.setAttribute(
        'aria-label',
        showing ? 'Remove the Lagos day trip' : 'Add a day trip to Lagos',
      );
    });
  }

  // ---------- scroll motion (spec §8: 240ms panels, reduced-motion handled
  // in CSS as a 120ms fade) ----------
  // Reveal classes are applied FROM JS so the document is complete without it.
  if ('IntersectionObserver' in window) {
    const targets = document.querySelectorAll(
      '.sec-head, .mode-card, .feature-row > *, .editor, .plan-steps > *, ' +
        '.about-grid > *, .cta-panel h2, .cta-panel p, .cta-panel .btn',
    );
    for (const el of targets) {
      el.classList.add('reveal');
      // Clear the finished animation so its forwards-fill cannot pin
      // transforms and swallow the card hover lift.
      el.addEventListener('animationend', () => el.classList.add('settled'), { once: true });
    }
    document.querySelectorAll('.mode-grid .mode-card').forEach((el, i) => {
      el.style.setProperty('--reveal-delay', `${i * 60}ms`);
    });
    document.querySelectorAll('.plan-steps .step-card').forEach((el, i) => {
      el.style.setProperty('--reveal-delay', `${i * 60}ms`);
    });
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -48px 0px' },
    );
    for (const el of targets) io.observe(el);
  }
</script>
</body>
</html>
